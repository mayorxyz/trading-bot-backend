# Copy to .env and fill in. Everything is optional; unset = local-dev defaults.

# --- Security ---
# When set, every route except GET /health requires the header X-API-Key: <value>.
API_KEY=

# Comma-separated browser origins allowed by CORS. "*" = any (local dev only).
CORS_ORIGINS=*

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR. Rotating files go to LOG_DIR (default data/logs).
LOG_LEVEL=INFO

# --- Storage locations (see paths.py) ---
# DATA_DIR=data
# LIVE_DB_PATH=live_state.db
# ANALYSIS_DB_PATH=analysis_runs.db
# SIGNALS_DB_PATH=signals.db
# BACKTEST_LOG_DB_PATH=backtest_signals.db

# --- Bybit client behaviour ---
# BYBIT_RETRY_ATTEMPTS=3
# BYBIT_RETRY_BACKOFF=0.4
